<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExamServer</RootNamespace>
    <!-- ExamServer.exe를 따로 만들지 않고 서명된 dotnet 프로그램으로 실행한다.
         (Windows 스마트 앱 컨트롤이 새로 빌드된 서명 없는 .exe를 막는 경우가 있어서) -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- DB는 설정(Database:Provider)으로 고른다: 개발은 SQLite, 학교 서버는 SQL Server 또는 PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
  </ItemGroup>

</Project>
