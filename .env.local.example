# 로컬에서 `vercel dev`로 테스트할 때 사용할 환경변수 예시 파일.
# 이 파일을 복사해서 .env.local 로 저장한 뒤 실제 값을 채우세요.
# .env.local 은 .gitignore에 이미 포함되어 있어 깃허브에 올라가지 않습니다.
#
# 실제 배포(Vercel) 시에는 이 파일이 아니라
# Vercel 대시보드 → 프로젝트 → Settings → Environment Variables 에
# 아래 두 값을 동일한 이름으로 등록해야 합니다.

# 학교(joshua.bible.ac.kr) API 인증 키 — 담당자에게 받은 X-BIBLE-APIGW-API-KEY 값
BIBLE_API_KEY=

# 학교 API 주소 — 학교 전산팀이 안내한 주소. 서버가 또 바뀌면 이 값만 교체하면 됨
# 비워두면 코드 안에 있는 기본 주소(https://joshua.bible.ac.kr/api/Space)가 자동으로 쓰임
BIBLE_API_URL=https://joshua.bible.ac.kr/api/Space

# 학생 로그인 세션 쿠키 서명용 비밀키 — 아무 무작위 긴 문자열이면 됨 (직접 생성)
SESSION_SECRET=

# 로컬 개발 전용 — true로 두면 학교 API를 부르지 않고 가짜(mock) 응답으로 로그인/졸업시험 조회를 테스트함.
# 테스트 계정: 학번 202200001 (신청 이력 4건) 또는 202300002 (이력 없음), 비밀번호는 둘 다 test1234
# 학교 서버가 다시 열리면 false로 바꾸거나 이 줄을 지우면 실제 API를 사용. Vercel 실제 배포엔 등록하지 말 것(등록해도 production에선 무시됨).
MOCK_BIBLE_API=false

# 로컬 개발 전용 — true로 두면 npm run dev(서버/API 없음)에서도 아래 테스트 계정으로 로그인할 수 있음.
#   학생: user123 / user123 (졸업시험 신청 이력 4건)   관리자: admin123 / admin123
# 개발 서버에서만 동작하고 실제 배포 빌드에는 포함되지 않음. Vercel에는 등록하지 말 것.
VITE_DEV_TEST_ACCOUNTS=false

# 로컬 개발 전용 — true로 두면 로그인(관리자/학생) 없이도 사이트 전체 화면에 바로 들어갈 수 있음.
# 학교 API 서버가 죽어있어도 화면 디자인/기능 작업할 때 유용. Vercel 실제 배포엔 이 값을 절대 등록하지 말 것.
VITE_SKIP_AUTH=false

# ──────────────── 관리자 로그인 (서버가 확인) ────────────────
# 예전에는 비밀번호가 브라우저 코드에 들어 있었지만, 이제는 서버 환경변수로만 확인한다.
# Vercel에도 반드시 같은 이름으로 등록해야 관리자 로그인이 된다 (비밀번호는 길고 어렵게).
ADMIN_ID=
ADMIN_PASSWORD=

# ──────────────── 연습문제 통계 (구글 시트, 서비스 계정) ────────────────
# 스프레드시트 ID — 시트 주소 https://docs.google.com/spreadsheets/d/여기가ID/edit 의 가운데 값 (주소 전체를 넣어도 됨)
GOOGLE_SHEETS_ID=
# 서비스 계정 이메일 — 이 이메일에 구글 시트 "편집자" 권한을 공유해야 함
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 서비스 계정 키 파일(JSON)의 "private_key" 값 전체 (-----BEGIN PRIVATE KEY----- 로 시작). 따옴표로 감싸고 줄바꿈은 \n 그대로 두면 됨
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# (선택) 학우ID(학번을 되돌릴 수 없게 암호화한 값) 전용 키. 비우면 SESSION_SECRET을 대신 씀.
# 한 번 정하면 바꾸지 마세요 — 바뀌면 이전 기록과 학우의 연결이 끊겨 "나의 연습문제 현황"이 비게 됩니다.
STATS_ID_SECRET=

# 로컬 개발 전용 — true로 두면 구글 시트 대신 임시 파일에 저장하고, 데모 통계 데이터가 미리 들어 있음.
# 실제 시트를 연결하려면 false로 바꾸거나 이 줄을 지울 것. (실서비스에서는 true여도 무시됨)
MOCK_STATS=false
# 개발 화면(npm run dev + admin123)에서 예시 통계를 보여줄지. false면 예시 없이 "기록 없음" 화면. 서버 mock의 예시 데이터는 MOCK_STATS_DEMO=false로 끔.
VITE_DEV_STATS_DEMO=true
